@prefix sk:   <https://w3id.org/skincare-kg/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix org:  <http://www.w3.org/ns/org#> .
@prefix schema: <https://schema.org/> .

#################################################################
#  Brand level claims
#
#  Two different things live in this file and they are modelled
#  differently on purpose.
#
#  1. Ownership is a FACT. Kenvue owns Neutrogena. It is asserted
#     directly, because a company report can settle it.
#
#  2. A boycott listing is a CLAIM. It is not a property of the
#     brand. It is something a named organisation said, on a named
#     day, on a stated basis. So it is reified: the listing itself
#     is an individual, with an authority, a date and a source.
#
#  This is the same three part shape already used for halal status
#  and for CosIng annex restrictions:
#     thing  ->  listing  ->  authority
#  It is the reason the provenance model exists. Anything that can
#  be disputed gets an author and a date rather than a bare value.
#################################################################

sk:Brand a owl:Class ;
    rdfs:subClassOf schema:Brand ;
    rdfs:label "Brand"@en .

sk:Company a owl:Class ;
    rdfs:subClassOf org:Organization ;
    rdfs:label "Company"@en .

sk:hasParentCompany a owl:ObjectProperty ;
    rdfs:domain sk:Brand ;
    rdfs:range  sk:Company ;
    rdfs:label  "has parent company"@en ;
    rdfs:comment "Corporate ownership. A verifiable fact, asserted directly."@en .

#################################################################
#  The reified listing
#################################################################

sk:BoycottListing a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Boycott listing"@en ;
    rdfs:comment """A statement by a named organisation that a brand or company
appears on its published list, together with the stated basis, the source
document and the date the source was read. This class deliberately does NOT
say the listing is correct. It says who published it and when."""@en .

sk:ListingAuthority a owl:Class ;
    rdfs:subClassOf prov:Agent , org:Organization ;
    rdfs:label "Listing authority"@en ;
    rdfs:comment "An organisation that publishes a list. A first class entity, so lists can be compared, dated and swapped."@en .

sk:hasBoycottListing a owl:ObjectProperty ;
    rdfs:domain sk:Brand ;
    rdfs:range  sk:BoycottListing .

sk:listingSubjectIsParent a owl:DatatypeProperty ;
    rdfs:domain sk:BoycottListing ;
    rdfs:range  xsd:boolean ;
    rdfs:comment """True when the listed entity is the parent company rather
than the brand itself. 'This brand is listed' and 'the company that owns this
brand is listed' are different sentences and must not be collapsed."""@en .

sk:listingLevel a owl:DatatypeProperty ;
    rdfs:domain sk:BoycottListing ;
    rdfs:range  xsd:string ;
    rdfs:comment "The tier the source itself assigns. The BDS guide separates priority targets, grassroots organic targets it supports but did not initiate, and pressure targets. Keeping the tier stops three different things being read as one."@en .

sk:listingBasis a owl:DatatypeProperty ;
    rdfs:domain sk:BoycottListing ;
    rdfs:range  xsd:string ;
    rdfs:comment "The reason the source gives, in the source's own words."@en .

#################################################################
#  Worked example, straight from reference/boycott_claims.csv
#################################################################

sk:brand-ahava a sk:Brand ;
    rdfs:label "AHAVA" ;
    sk:hasBoycottListing sk:listing-bds-ahava-2026-09-10 .

sk:listing-bds-ahava-2026-09-10 a sk:BoycottListing ;
    rdfs:label "AHAVA on the BDS consumer boycott priority list" ;
    prov:wasAttributedTo sk:authority-bnc ;
    sk:listingLevel "1 priority target" ;
    sk:listingBasis "Accused of involvement in illegal Israeli settlements" ;
    sk:listingSubjectIsParent false ;
    dct:source <https://www.ethicalconsumer.org/ethical-campaigns-boycotts/palestine-boycott-list> ;
    prov:generatedAtTime "2026-09-10"^^xsd:date .

sk:authority-bnc a sk:ListingAuthority ;
    rdfs:label "Palestinian BDS National Committee" ;
    schema:url <https://bdsmovement.net/> .

#################################################################
#  Why this shape and not a boolean
#
#  A system that publishes  sk:product-123 sk:boycotted true
#  is making a political assertion in its own voice, with no way
#  for a user to see where it came from or when it was last true.
#
#  A system that publishes the listing above is reporting. The user
#  can see the organisation, the tier, the reason, the URL and the
#  date, and can decide for themselves. If a brand's position
#  changes, a new listing is added and the old one keeps its date,
#  so the history stays readable.
#
#  The same argument applies to cruelty free and to organic, which
#  are also claims by certifiers rather than properties of a formula.
#  This pattern covers all three.
#################################################################
